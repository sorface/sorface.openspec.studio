{
  "name": "openspec-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node ../tooling/scripts/dev.mjs",
    "dev:web": "vite --config vite.local.config.ts",
    "dev:backend": "node ../tooling/scripts/dev-backend.mjs",
    "build": "node ../tooling/scripts/build.mjs",
    "build:web": "vite build --config vite.local.config.ts",
    "build:site": "vinext build",
    "build:backend": "node ../tooling/scripts/build-backend.mjs",
    "release": "node ../tooling/scripts/release.mjs",
    "start": "node ../tooling/scripts/start.mjs",
    "start:site": "vinext start",
    "setup": "npm install && npm run check && npm run build && npm start",
    "check": "npm run lint && npm run typecheck && npm test",
    "test": "npm run test:web && npm run test:backend && npm run test:kotlin-http && npm run test:openspec",
    "test:web": "npm run build:site && node --test tests/*.test.mjs",
    "test:backend": "mvn -q -f ../openspec.backend/pom.xml verify",
    "test:kotlin-http": "node ../tooling/scripts/test-kotlin-http.mjs",
    "test:openspec": "openspec validate --specs --strict --json --no-interactive",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc -p tsconfig.app.json"
  },
  "dependencies": {
    "@milkdown/crepe": "^7.21.3",
    "@milkdown/kit": "^7.21.3",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.7.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13"
  },
  "type": "module"
}
